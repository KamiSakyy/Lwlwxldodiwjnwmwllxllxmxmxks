<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран диалогов — перенос разметки старого мессенджера один в один:
  шапка 56dp (#0d0d0d, линия #1c1c1c) с круглой кнопкой меню 40dp,
  заголовок 20sp/900 с разрядкой 0.8, подпись 12sp #8e8e93,
  поиск (padding 8/12, поле radius 12 #1c1c1e с рамкой #2a2a2c),
  папки-пилюли (radius 16, активная #2c2c2e + рамка #3a3a3c),
  список чатов и нижняя навигация 50dp (#0d0d0d, линия #1a1a1a).
  Слева выезжает меню-панель: 82% ширины (max 320dp), фон #141416,
  шапка меню 24/18 (#1c1c1e, линия #28282a), аватар 72dp, имя 18sp/700.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/main_toolbar"
            style="@style/Widget.MailGram.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nav_bar"
            android:minHeight="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            app:menu="@menu/menu_main"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/text_primary"
            app:subtitle="@string/app_name"
            app:subtitleTextAppearance="@style/TextAppearance.MailGram.HeaderSubtitle"
            app:title="@string/chats_title"
            app:titleTextAppearance="@style/TextAppearance.MailGram.HeaderMain" />

        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nav_bar"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_search_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_icon" />

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/folder_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nav_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/filter_all"
                style="@style/Widget.MailGram.FolderTabActive"
                android:layout_marginEnd="4dp"
                android:text="@string/filter_all" />

            <TextView
                android:id="@+id/filter_unread"
                style="@style/Widget.MailGram.FolderTab"
                android:layout_marginEnd="4dp"
                android:text="@string/filter_unread" />

            <TextView
                android:id="@+id/filter_pinned"
                style="@style/Widget.MailGram.FolderTab"
                android:text="@string/filter_pinned" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/sync_bar"
            style="@style/Widget.MailGram.Progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_chats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="21dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/empty_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/empty_icon"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_icon_circle_soft">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/no_chats_title"
                        android:src="@drawable/ic_chat"
                        app:tint="@color/brand" />
                </FrameLayout>

                <TextView
                    android:id="@+id/empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/no_chats_title"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/empty_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/no_chats_text"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/empty_action"
                    style="@style/Widget.MailGram.Button.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginTop="22dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:text="@string/start_chat" />
            </LinearLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_new_chat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="20dp"
                android:contentDescription="@string/new_chat"
                app:backgroundTint="@color/brand"
                app:elevation="4dp"
                app:fabCustomSize="44dp"
                app:maxImageSize="20dp"
                app:rippleColor="@color/ripple_strong"
                app:srcCompat="@drawable/ic_edit"
                app:tint="@color/text_on_accent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_bottom_nav"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nav_chats"
                style="@style/Widget.MailGram.NavItem">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/chats_title"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/text_primary" />

                <TextView
                    style="@style/Widget.MailGram.NavLabel"
                    android:text="@string/chats_title"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_channels"
                style="@style/Widget.MailGram.NavItem">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/channel_messages"
                    android:src="@drawable/ic_globe"
                    app:tint="@color/text_muted" />

                <TextView
                    style="@style/Widget.MailGram.NavLabel"
                    android:text="@string/channel_messages" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_contacts"
                style="@style/Widget.MailGram.NavItem">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/new_chat"
                    android:src="@drawable/ic_person"
                    app:tint="@color/text_muted" />

                <TextView
                    style="@style/Widget.MailGram.NavLabel"
                    android:text="@string/new_chat" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_settings"
                style="@style/Widget.MailGram.NavItem">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_muted" />

                <TextView
                    style="@style/Widget.MailGram.NavLabel"
                    android:text="@string/settings" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_drawer"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/drawer_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_drawer_header"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="24dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <com.mailgram.app.ui.AvatarView
                android:id="@+id/drawer_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/drawer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/me"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/drawer_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/drawer_online"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/success"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/drawer_item_new_chat"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/new_chat"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/text_dim" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/new_chat"
                        android:textColor="@color/text_drawer"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawer_item_contacts"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/contacts_title"
                        android:src="@drawable/ic_person"
                        app:tint="@color/text_dim" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/contacts_title"
                        android:textColor="@color/text_drawer"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawer_item_invite"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/invite_contact"
                        android:src="@drawable/ic_send"
                        app:tint="@color/text_dim" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/invite_contact"
                        android:textColor="@color/text_drawer"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawer_item_notifications"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/settings_notifications"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/text_dim" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_notifications"
                        android:textColor="@color/text_drawer"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawer_item_security"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/settings_security"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/text_dim" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_security"
                        android:textColor="@color/text_drawer"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawer_item_my_key"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/my_key"
                        android:src="@drawable/ic_key"
                        app:tint="@color/text_dim" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/my_key"
                        android:textColor="@color/text_drawer"
                        android:textSize="15sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="@color/row_divider" />

                <LinearLayout
                    android:id="@+id/drawer_item_settings"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/settings"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/text_dim" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings"
                        android:textColor="@color/text_drawer"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawer_item_logout"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/logout"
                        android:src="@drawable/ic_logout"
                        app:tint="@color/danger" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/logout"
                        android:textColor="@color/danger"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
