<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран диалогов — разметка один в один со старого мессенджера:
  .header 56px (#0d0d0d, линия #1c1c1c): кнопка меню 40px (rgba(255,255,255,.08),
  иконка 22px stroke 2.5), заголовок 20px/900 с разрядкой 0.8, подпись 12px #8e8e93,
  кнопка шифрования 38px активная (rgba(255,255,255,.15), белая иконка 20px).
  .search-bar-container: отступы 8/12, поле radius 12 (#1c1c1e, рамка #2a2a2c), иконка 18px.
  #folderTabs: отступы 8/12, пилюли radius 16px.
  .bottom-nav 50px: «Чаты», «Профиль», «Выход» — иконки 22px stroke 2, подпись 10px.
  .drawer: 82% ширины, фон #141416, шапка 24/18 на #1c1c1e с линией #28282a,
  аватар 72px, имя 18px/700, статус «в сети» 13px #34c759, пункты 20px-иконки.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/main_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@drawable/bg_nav_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/main_menu_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_icon_circle_soft"
                android:contentDescription="@string/menu"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:id="@+id/main_title_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/main_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="0.03"
                    android:maxLines="1"
                    android:text="@string/chats_title"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/main_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/online_now"
                    android:textColor="@color/text_icon"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/main_encrypt_btn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_circle_strong"
                android:contentDescription="@string/settings_security"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lock"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_bar"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search_pill"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_icon" />

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="40dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/folder_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nav_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/filter_all"
                style="@style/Widget.MailGram.FolderTabActive"
                android:layout_marginEnd="4dp"
                android:text="@string/filter_all" />

            <TextView
                android:id="@+id/filter_unread"
                style="@style/Widget.MailGram.FolderTab"
                android:layout_marginEnd="4dp"
                android:text="@string/filter_unread" />

            <TextView
                android:id="@+id/filter_pinned"
                style="@style/Widget.MailGram.FolderTab"
                android:text="@string/filter_pinned" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/sync_bar"
            style="@style/Widget.MailGram.Progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_chats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/empty_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/empty_icon"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_icon_circle_soft">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/no_chats_title"
                        android:src="@drawable/ic_nav_chats"
                        app:tint="@color/brand" />
                </FrameLayout>

                <TextView
                    android:id="@+id/empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/no_chats_title"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/empty_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/no_chats_text"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/empty_action"
                    style="@style/Widget.MailGram.Button.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginTop="22dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:text="@string/start_chat" />
            </LinearLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_new_chat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                android:contentDescription="@string/new_chat"
                app:backgroundTint="@color/brand"
                app:elevation="4dp"
                app:fabCustomSize="44dp"
                app:maxImageSize="20dp"
                app:rippleColor="@color/ripple_strong"
                app:srcCompat="@drawable/ic_edit_big"
                app:tint="@color/text_on_accent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:background="@drawable/bg_bottom_nav"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nav_chats"
                style="@style/Widget.MailGram.NavItem"
                android:layout_height="50dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/chats_title"
                    android:src="@drawable/ic_nav_chats"
                    app:tint="@color/text_primary" />

                <TextView
                    style="@style/Widget.MailGram.NavLabel"
                    android:text="@string/chats_title"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_profile"
                style="@style/Widget.MailGram.NavItem"
                android:layout_height="50dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/me"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/text_muted" />

                <TextView
                    style="@style/Widget.MailGram.NavLabel"
                    android:text="@string/me" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_logout"
                style="@style/Widget.MailGram.NavItem"
                android:layout_height="50dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/logout"
                    android:src="@drawable/ic_nav_logout"
                    app:tint="@color/text_muted" />

                <TextView
                    style="@style/Widget.MailGram.NavLabel"
                    android:text="@string/logout" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_drawer"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/drawer_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_drawer_header"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="24dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="4dp">

                <com.mailgram.app.ui.AvatarView
                    android:id="@+id/drawer_avatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp" />

                <ImageView
                    android:id="@+id/drawer_avatar_edit"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_white_circle"
                    android:contentDescription="@string/me"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/text_on_light" />
            </FrameLayout>

            <TextView
                android:id="@+id/drawer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/me"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/drawer_online"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/online_now"
                android:textColor="@color/success"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/drawer_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/drawer_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/me"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/text_dim" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/drawer_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/drawer_item_stealth"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/drawer_stealth"
                        android:src="@drawable/ic_eye_off"
                        app:tint="@color/text_dim" />

                    <TextView
                        style="@style/Widget.MailGram.DrawerItemText"
                        android:text="@string/drawer_stealth" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawer_item_sound"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/drawer_sound"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/text_dim" />

                    <TextView
                        style="@style/Widget.MailGram.DrawerItemText"
                        android:text="@string/drawer_sound" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawer_item_encrypt"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/drawer_encrypt"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/text_dim" />

                    <TextView
                        style="@style/Widget.MailGram.DrawerItemText"
                        android:text="@string/drawer_encrypt" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawer_item_pin"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/app_lock"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/text_dim" />

                    <TextView
                        style="@style/Widget.MailGram.DrawerItemText"
                        android:text="@string/app_lock" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawer_item_settings"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/settings"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/text_dim" />

                    <TextView
                        style="@style/Widget.MailGram.DrawerItemText"
                        android:text="@string/settings" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawer_item_logout"
                    style="@style/Widget.MailGram.DrawerItem">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/logout"
                        android:src="@drawable/ic_logout_small"
                        app:tint="@color/text_dim" />

                    <TextView
                        style="@style/Widget.MailGram.DrawerItemText"
                        android:text="@string/drawer_logout" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
