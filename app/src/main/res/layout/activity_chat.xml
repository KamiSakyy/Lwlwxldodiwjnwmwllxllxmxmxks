<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_wallpaper"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_glass"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/chat_back"
            style="@style/Widget.MailGram.GlassIcon"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="?attr/colorOnSurface" />

        <com.mailgram.app.ui.AvatarView
            android:id="@+id/chat_avatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:id="@+id/chat_title_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.MailGram.ChatTitle"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/chat_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.MailGram.ChatSubtitle"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/chat_search_btn"
            style="@style/Widget.MailGram.GlassIcon"
            android:contentDescription="@string/search_chat"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/chat_menu_btn"
            style="@style/Widget.MailGram.GlassIcon"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chat_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/chat_search_edit"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/search_chat"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/chat_search_close"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chat_pinned"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/pin_chat"
            android:src="@drawable/ic_pin"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/chat_pinned_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/chat_pinned_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chat_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chat_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_banner_action"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/invite_contact"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <FrameLayout
            android:id="@+id/scroll_down_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btn_scroll_down"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_badge"
                android:contentDescription="@string/scroll_down"
                android:padding="10dp"
                android:src="@drawable/ic_scroll_down"
                app:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/scroll_unread_badge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/voice_record_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/voice_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@string/attach_voice"
                    android:src="@drawable/ic_record_dot" />

                <TextView
                    android:id="@+id/voice_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="0:00"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/voice_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/voice_hold"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.mailgram.app.media.VoiceWaveView
                android:id="@+id/voice_live_wave"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/chat_reply_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <View
            android:layout_width="3dp"
            android:layout_height="34dp"
            android:background="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_reply_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chat_reply_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/chat_reply_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/emoji_panel"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="?attr/colorSurface"
        android:columnCount="8"
        android:padding="6dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/selection_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_toolbar_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/sel_close"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/selection_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:text="@string/select"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <ImageView
            android:id="@+id/sel_copy"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/copy"
            android:padding="10dp"
            android:src="@drawable/ic_copy"
            app:tint="?attr/colorOnSurface" />

        <ImageView
            android:id="@+id/sel_forward"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/forward"
            android:padding="10dp"
            android:src="@drawable/ic_forward"
            app:tint="?attr/colorOnSurface" />

        <ImageView
            android:id="@+id/sel_pin"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pin_chat"
            android:padding="10dp"
            android:src="@drawable/ic_pin"
            app:tint="?attr/colorOnSurface" />

        <ImageView
            android:id="@+id/sel_delete"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_for_all"
            android:padding="10dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/google_red" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btn_attach"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/attach_title"
            android:src="@drawable/ic_attach_plus"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btn_emoji"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/emoji"
            android:src="@drawable/ic_emoji"
            app:tint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/input_edit"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/message_hint"
            android:imeOptions="actionSend|flagNoEnterAction"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btn_mic"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/attach_voice"
            android:padding="8dp"
            android:src="@drawable/ic_mic"
            app:tint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/send"
            android:visibility="gone"
            app:backgroundTint="?attr/colorPrimary"
            app:fabCustomSize="46dp"
            app:srcCompat="@drawable/ic_send"
            app:tint="#FFFFFFFF" />
    </LinearLayout>
</LinearLayout>
