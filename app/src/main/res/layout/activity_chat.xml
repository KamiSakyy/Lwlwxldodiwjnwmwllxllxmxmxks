<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран чата — перенос разметки старого мессенджера один в один.
  Шапка 56dp (#0d0d0d, линия #1c1c1c): кнопка назад 40dp, аватар 38dp,
  имя 16sp/700, подпись 12sp #8e8e93, круглые кнопки 38dp (padding 4dp).
  Сообщения: фон-обои, пузыри radius 18dp (#1c1c1e / #2c2c2e).
  Поле ввода: полоса #0d0d0d с линией #1a1a1a, поле radius 20dp (#1c1c1e,
  рамка #2a2a2c), смайлик внутри поля, круглые кнопки 38dp, отправка — белый круг.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_chat_wallpaper"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/chat_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@drawable/bg_nav_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/chat_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle_soft"
                android:contentDescription="@string/back"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <com.mailgram.app.ui.AvatarView
                android:id="@+id/chat_avatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp" />

            <LinearLayout
                android:id="@+id/chat_title_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chat_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chat_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_icon"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/chat_search_btn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_circle_faint"
                android:contentDescription="@string/search"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search_chat"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/chat_menu_btn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_circle_strong"
                android:contentDescription="@string/settings"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_dim" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_offline_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/chat_banner_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_on_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chat_banner_action"
                style="@style/Widget.MailGram.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/text_on_light"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pinned_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_icon" />

                <EditText
                    android:id="@+id/chat_search_edit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_messages"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/chat_search_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_circle_soft"
                android:contentDescription="@string/close"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_pinned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pinned_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@color/brand" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/pinned_title"
                    android:src="@drawable/ic_pin"
                    app:tint="@color/brand" />

                <TextView
                    android:id="@+id/chat_pinned_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/pinned_title"
                    android:textColor="@color/brand"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chat_pinned_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/chat_pinned_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_icon_ripple_round"
                android:contentDescription="@string/close"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                android:scrollbars="none" />

            <FrameLayout
                android:id="@+id/scroll_down_wrap"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_scroll_fab"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btn_scroll_down"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/scroll_down"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_scroll_down"
                    app:tint="@color/text_on_accent" />

                <TextView
                    android:id="@+id/scroll_unread_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge_red"
                    android:gravity="center"
                    android:minWidth="20dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textColor="@color/text_on_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/chat_reply_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pinned_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@color/text_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chat_reply_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chat_reply_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/chat_reply_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_icon_ripple_round"
                android:contentDescription="@string/close"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/emoji_panel"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="@drawable/bg_sheet"
            android:columnCount="8"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/voice_record_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nav_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <View
                    android:id="@+id/voice_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_badge_red" />

                <TextView
                    android:id="@+id/voice_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minWidth="40dp"
                    android:text="0:00"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/voice_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.mailgram.app.media.VoiceWaveView
                    android:id="@+id/voice_live_wave"
                    android:layout_width="72dp"
                    android:layout_height="24dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pinned_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/sel_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_ripple_round"
                android:contentDescription="@string/close"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/text_icon" />

            <TextView
                android:id="@+id/selection_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/sel_copy"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_circle_faint"
                android:contentDescription="@string/copy"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_copy"
                app:tint="@color/text_dim" />

            <ImageView
                android:id="@+id/sel_pin"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_circle_faint"
                android:contentDescription="@string/pin_chat"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pin"
                app:tint="@color/text_dim" />

            <ImageView
                android:id="@+id/sel_forward"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_circle_faint"
                android:contentDescription="@string/forward"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_forward"
                app:tint="@color/text_dim" />

            <ImageView
                android:id="@+id/sel_delete"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_circle_faint"
                android:contentDescription="@string/delete"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_delete"
                app:tint="@color/danger" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/input_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nav_bar"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btn_attach"
                android:layout_width="38dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_ripple_round"
                android:contentDescription="@string/attach_title"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_attach"
                app:tint="@color/text_dim" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <EditText
                    android:id="@+id/input_edit"
                    style="@style/Widget.MailGram.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/message_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:minHeight="42dp"
                    android:paddingEnd="46dp" />

                <ImageButton
                    android:id="@+id/btn_emoji"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_icon_ripple_round"
                    android:contentDescription="@string/emoji"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_emoji"
                    app:tint="@color/text_icon" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btn_circle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_send"
                android:contentDescription="@string/attach_circle"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_circle_video"
                app:tint="@color/text_on_light" />

            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_send"
                android:contentDescription="@string/voice_message"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                app:tint="@color/text_on_light" />

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_send"
                android:contentDescription="@string/send"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send"
                android:visibility="gone"
                app:tint="@color/text_on_light" />
        </LinearLayout>
    </LinearLayout>

    <!-- Шторка действий: .action-sheet → .action-sheet-content (radius 20 сверху, #1c1c1e) -->
    <LinearLayout
        android:id="@+id/chat_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay"
        android:gravity="bottom"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chat_sheet_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/action_pin"
                style="@style/Widget.MailGram.ActionItem"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/pin_chat"
                    android:src="@drawable/ic_pin"
                    app:tint="@color/text_dim" />

                <TextView
                    style="@style/Widget.MailGram.ActionItemText"
                    android:text="@string/pin_chat"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_mute"
                style="@style/Widget.MailGram.ActionItem"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/mute_chat"
                    android:src="@drawable/ic_mute"
                    app:tint="@color/text_dim" />

                <TextView
                    style="@style/Widget.MailGram.ActionItemText"
                    android:text="@string/mute_chat"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_search"
                style="@style/Widget.MailGram.ActionItem"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/search_messages"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_dim" />

                <TextView
                    style="@style/Widget.MailGram.ActionItemText"
                    android:text="@string/search_messages"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_export"
                style="@style/Widget.MailGram.ActionItem"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/chat_menu_export"
                    android:src="@drawable/ic_download"
                    app:tint="@color/text_dim" />

                <TextView
                    style="@style/Widget.MailGram.ActionItemText"
                    android:text="@string/chat_menu_export"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_safety"
                style="@style/Widget.MailGram.ActionItem"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/chat_menu_safety"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/text_dim" />

                <TextView
                    style="@style/Widget.MailGram.ActionItemText"
                    android:text="@string/chat_menu_safety"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_rename"
                style="@style/Widget.MailGram.ActionItem"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/chat_menu_rename"
                    android:src="@drawable/ic_edit_big"
                    app:tint="@color/text_dim" />

                <TextView
                    style="@style/Widget.MailGram.ActionItemText"
                    android:text="@string/chat_menu_rename"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_clear"
                style="@style/Widget.MailGram.ActionItem"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/chat_menu_clear"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/text_dim" />

                <TextView
                    style="@style/Widget.MailGram.ActionItemText"
                    android:text="@string/chat_menu_clear"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_delete"
                style="@style/Widget.MailGram.ActionItem">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/chat_menu_delete"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/danger" />

                <TextView
                    style="@style/Widget.MailGram.ActionItemText"
                    android:text="@string/chat_menu_delete"
                    android:textColor="@color/danger" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Профиль собеседника: обложка 150dp, аватар 100dp с рамкой 4dp #000, имя 20sp/700 -->
    <LinearLayout
        android:id="@+id/profile_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/profile_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@drawable/bg_nav_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/profile_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle_soft"
                android:contentDescription="@string/back"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/chat_info"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/profile_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_profile_cover" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-50dp"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <com.mailgram.app.ui.AvatarView
                        android:id="@+id/profile_avatar"
                        android:layout_width="100dp"
                        android:layout_height="100dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/profile_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/profile_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_icon"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/profile_info_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dim"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/profile_info_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/text_dim"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/profile_key_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_key_box"
                        android:fontFamily="monospace"
                        android:padding="10dp"
                        android:textColor="@color/key_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Крипто-модалка: #161616, radius 20dp, рамка #282828, key-box #0a0a0a -->
    <LinearLayout
        android:id="@+id/encrypt_modal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/encrypt_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_modal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_security"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/encrypt_warn"
                style="@style/Widget.MailGram.WarnBox"
                android:layout_marginTop="12dp"
                android:text="@string/encryption_on" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.08"
                android:text="@string/my_key"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/encrypt_key_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_key_box"
                android:fontFamily="monospace"
                android:maxHeight="80dp"
                android:padding="10dp"
                android:textColor="@color/key_text"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/encrypt_safety_box"
                style="@style/Widget.MailGram.InfoBox"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/encrypt_delfan_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_info_box"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:textColor="@color/brand"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/encrypt_copy"
                style="@style/Widget.MailGram.Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="18dp"
                android:text="@string/copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/encrypt_close"
                style="@style/Widget.MailGram.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
