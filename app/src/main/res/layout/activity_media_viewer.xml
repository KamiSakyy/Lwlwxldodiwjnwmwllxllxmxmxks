<?xml version="1.0" encoding="utf-8"?>
<!-- Просмотр медиа: чёрный холст, шапка и нижняя панель прячутся по тапу. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/viewer_toolbar"
        style="@style/Widget.MailGram.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_bar"
        android:minHeight="56dp"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/text_primary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/viewer_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/image"
            android:scaleType="fitCenter" />

        <FrameLayout
            android:id="@+id/viewer_video_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <VideoView
                android:id="@+id/viewer_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/viewer_voice_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_glass_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/viewer_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_voice_play"
                android:contentDescription="@string/attach_voice"
                android:padding="14dp"
                android:src="@drawable/ic_play"
                app:tint="@color/brand" />

            <com.mailgram.app.media.VoiceWaveView
                android:id="@+id/viewer_wave"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/viewer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textAppearance="@style/TextAppearance.MailGram.Caption"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/viewer_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewer_save"
            style="@style/Widget.MailGram.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewer_share"
            style="@style/Widget.MailGram.Button.Accent"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/share" />
    </LinearLayout>
</LinearLayout>
