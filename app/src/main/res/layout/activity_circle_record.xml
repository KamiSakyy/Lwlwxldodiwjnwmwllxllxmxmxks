<?xml version="1.0" encoding="utf-8"?>
<!-- Запись видеосообщения-«кружка»: превью по центру, таймер сверху, кнопки снизу. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/circle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <SurfaceView
            android:id="@+id/circle_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <com.mailgram.app.media.CircleMaskView
            android:id="@+id/circle_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/circle_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_video_chip"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="0:00"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/circle_cancel"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="28dp"
        android:layout_marginBottom="56dp"
        android:background="@drawable/bg_circle_btn_cancel"
        android:contentDescription="@string/cancel"
        android:padding="14dp"
        android:src="@drawable/ic_close"
        app:tint="@color/text_primary" />

    <ImageView
        android:id="@+id/circle_stop"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="56dp"
        android:background="@drawable/bg_circle_btn_stop"
        android:contentDescription="@string/attach_circle"
        android:padding="12dp"
        android:src="@drawable/ic_stop_circle"
        app:tint="@color/text_primary" />
</FrameLayout>
