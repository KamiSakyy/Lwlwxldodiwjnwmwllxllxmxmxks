<?xml version="1.0" encoding="utf-8"?>
<!--
  Шторка вложений — как .action-sheet-content: фон #1c1c1e со скруглением 20dp
  сверху, пункты radius 12dp на #2c2c2e, подпись 15sp/500.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/attach_photo"
        style="@style/Widget.MailGram.ActionItem"
        android:layout_marginBottom="8dp"
        android:layout_weight="0"
        android:gravity="center_vertical"
        android:text="@string/attach_photo">

    </TextView>

    <TextView
        android:id="@+id/attach_video"
        style="@style/Widget.MailGram.ActionItem"
        android:layout_marginBottom="8dp"
        android:text="@string/attach_video" />

    <TextView
        android:id="@+id/attach_circle"
        style="@style/Widget.MailGram.ActionItem"
        android:layout_marginBottom="8dp"
        android:text="@string/attach_circle" />

    <TextView
        android:id="@+id/attach_file"
        style="@style/Widget.MailGram.ActionItem"
        android:layout_marginBottom="8dp"
        android:text="@string/attach_file" />

    <TextView
        android:id="@+id/attach_camera"
        style="@style/Widget.MailGram.ActionItem"
        android:text="@string/attach_camera" />

    <TextView
        android:id="@+id/attach_limits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />
</LinearLayout>
