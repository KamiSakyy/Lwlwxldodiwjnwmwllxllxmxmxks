<?xml version="1.0" encoding="utf-8"?>
<!-- Мастер настройки OAuth: пошаговая карточка с данными приложения и полями клиента. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/setup_toolbar"
        style="@style/Widget.MailGram.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_bar"
        android:minHeight="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/setup_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/setup_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/setup_intro"
                android:textAppearance="@style/TextAppearance.MailGram.BodySmall" />

            <TextView
                style="@style/Widget.MailGram.SectionTitle"
                android:paddingStart="4dp"
                android:text="@string/setup_package" />

            <LinearLayout style="@style/Widget.MailGram.Card" android:padding="16dp">

                <TextView
                    android:id="@+id/setup_package"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MailGram.BodySmall"
                    android:textColor="@color/text_primary"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/setup_sha1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.MailGram.Caption"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/setup_redirect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.MailGram.Caption"
                    android:textIsSelectable="true" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_setup"
                style="@style/Widget.MailGram.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="@string/copy_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_console"
                style="@style/Widget.MailGram.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/setup_open_console" />

            <TextView
                style="@style/Widget.MailGram.SectionTitle"
                android:paddingStart="4dp"
                android:text="@string/setup_client_id_hint" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/setup_client_wrap"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/setup_client_id_hint"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/brand">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/setup_client_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/setup_secret_wrap"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/setup_client_secret"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/brand">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/setup_client_secret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.MailGram.SectionTitle"
                android:paddingStart="4dp"
                android:text="@string/setup_mode" />

            <LinearLayout style="@style/Widget.MailGram.Card" android:paddingStart="8dp" android:paddingEnd="8dp">

                <RadioGroup
                    android:id="@+id/setup_mode_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/setup_mode_android"
                        style="@style/Widget.MailGram.RadioButton"
                        android:layout_width="match_parent"
                        android:text="@string/setup_mode_android" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/setup_mode_loopback"
                        style="@style/Widget.MailGram.RadioButton"
                        android:layout_width="match_parent"
                        android:text="@string/setup_mode_loopback" />
                </RadioGroup>

                <TextView
                    android:id="@+id/setup_mode_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="12dp"
                    android:textAppearance="@style/TextAppearance.MailGram.Caption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_setup_save"
                style="@style/Widget.MailGram.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/setup_save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
