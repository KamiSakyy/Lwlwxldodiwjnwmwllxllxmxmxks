<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorChatBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/setup_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/setup_title"
        app:titleTextColor="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/setup_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="@string/setup_intro"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView style="@style/TextAppearance.MailGram.Caption"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/setup_package" />

                <TextView android:id="@+id/setup_package" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurface" android:textIsSelectable="true" />

                <TextView style="@style/TextAppearance.MailGram.Caption"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="@string/setup_sha1" />

                <TextView android:id="@+id/setup_sha1" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurface" android:textIsSelectable="true" />

                <TextView style="@style/TextAppearance.MailGram.Caption"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="@string/setup_redirect" />

                <TextView android:id="@+id/setup_redirect" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurface" android:textIsSelectable="true" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_setup"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="12dp" android:text="@string/copy_all"
                android:textAllCaps="false"
                app:icon="@drawable/ic_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_console"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="@string/setup_open_console" android:textAllCaps="false"
                app:icon="@drawable/ic_globe" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/setup_client_wrap"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/setup_client_id">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/setup_client_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/setup_secret_wrap"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/setup_client_secret"
                app:helperText="@string/setup_client_secret_help"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/setup_client_secret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/TextAppearance.MailGram.Caption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:layout_marginBottom="4dp"
                android:text="@string/setup_mode" />

            <RadioGroup
                android:id="@+id/setup_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/setup_mode_android" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/setup_mode_android" />
                <RadioButton android:id="@+id/setup_mode_loopback" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/setup_mode_loopback" />
            </RadioGroup>

            <TextView android:id="@+id/setup_mode_note" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_setup_save"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="18dp" android:text="@string/setup_save"
                android:textAllCaps="false" app:cornerRadius="26dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
