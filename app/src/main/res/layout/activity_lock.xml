<?xml version="1.0" encoding="utf-8"?>
<!-- Экран блокировки: аватар, точки PIN и цифровая клавиатура на чёрном фоне. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="48dp">

    <com.mailgram.app.ui.AvatarView
        android:id="@+id/lock_avatar"
        android:layout_width="84dp"
        android:layout_height="84dp" />

    <TextView
        android:id="@+id/lock_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/pin_enter"
        android:textAppearance="@style/TextAppearance.MailGram.Title" />

    <TextView
        android:id="@+id/lock_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/app_lock_desc"
        android:textAppearance="@style/TextAppearance.MailGram.Caption" />

    <LinearLayout
        android:id="@+id/lock_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <GridLayout
        android:id="@+id/lock_keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:columnCount="3"
        android:rowCount="4" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.MailGram.Caption"
        android:textColor="@color/text_tertiary" />
</LinearLayout>
