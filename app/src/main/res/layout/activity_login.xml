<?xml version="1.0" encoding="utf-8"?>
<!-- Вход: чистый чёрный фон, крупный знак, белая кнопка Google (как в iOS-сплэше). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="72dp"
        android:paddingEnd="28dp"
        android:paddingBottom="40dp">

        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:background="@drawable/bg_glass_panel">

            <ImageView
                android:id="@+id/login_logo"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo_mailgram" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.MailGram.Hero" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/tagline"
            android:textAppearance="@style/TextAppearance.MailGram.BodySmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/login_subtitle"
            android:textAppearance="@style/TextAppearance.MailGram.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_google"
            style="@style/Widget.MailGram.Button.Accent"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:backgroundTint="@color/text_primary"
            android:text="@string/sign_in_google"
            android:textColor="@color/text_on_light" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/login_progress"
            style="@style/Widget.MailGram.Progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textAppearance="@style/TextAppearance.MailGram.Caption"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_setup"
            android:visibility="gone"
            style="@style/Widget.MailGram.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:text="@string/login_setup" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_diag"
            android:visibility="gone"
            style="@style/Widget.MailGram.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="@string/login_check" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/login_footer"
            android:textAppearance="@style/TextAppearance.MailGram.Caption"
            android:textColor="@color/text_tertiary" />
    </LinearLayout>
</ScrollView>
