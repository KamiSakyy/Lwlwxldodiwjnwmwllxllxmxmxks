<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorChatBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:subtitle="@string/settings"
        app:title="@string/app_name"
        app:titleTextColor="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.mailgram.app.ui.AvatarView
                    android:id="@+id/settings_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/settings_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/settings_identity_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/TextAppearance.MailGram.Caption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" android:text="@string/settings_appearance" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_card" android:orientation="vertical" android:padding="8dp">

                <RadioGroup
                    android:id="@+id/theme_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton android:id="@+id/theme_system" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/theme_system" />
                    <RadioButton android:id="@+id/theme_light" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/theme_light" />
                    <RadioButton android:id="@+id/theme_dark" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/theme_dark" />
                </RadioGroup>
            </LinearLayout>

            <TextView style="@style/TextAppearance.MailGram.Caption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" android:text="@string/settings_sync" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">

                <LinearLayout
                    android:id="@+id/row_poll"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical" android:orientation="horizontal">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/settings_poll"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView android:id="@+id/settings_poll_value" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_background"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/settings_background"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_background_desc"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_notifications"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/settings_notifications"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <LinearLayout
                    android:id="@+id/row_font_scale"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical" android:orientation="horizontal">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/settings_font"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView android:id="@+id/settings_font_value" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_animations"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/settings_animations"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
            </LinearLayout>

            <TextView style="@style/TextAppearance.MailGram.Caption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" android:text="@string/settings_security" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:id="@+id/row_ratchet" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical" android:orientation="horizontal">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/settings_ratchet"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView android:id="@+id/settings_ratchet_state" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_selftest" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:contentDescription="@string/settings_selftest"
                        android:src="@drawable/ic_shield_accent" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1"
                        android:text="@string/settings_selftest"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <TextView android:id="@+id/settings_selftest_result" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_app_lock"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/app_lock"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/app_lock_desc"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout android:id="@+id/row_mykey" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground" android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:contentDescription="@string/my_key" android:src="@drawable/ic_key" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/my_key"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_invite_link" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground" android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:contentDescription="@string/invite_contact" android:src="@drawable/ic_globe" />
                    <TextView android:id="@+id/settings_invite_link" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_marginStart="12dp"
                        android:layout_weight="1" android:ellipsize="middle" android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/TextAppearance.MailGram.Caption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" android:text="@string/setup_title" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:id="@+id/row_setup" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:contentDescription="@string/setup_title" android:src="@drawable/ic_help" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1"
                        android:text="@string/setup_title"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <TextView android:id="@+id/settings_client_id" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:fontFamily="monospace" android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:textIsSelectable="true" />

                <TextView android:id="@+id/settings_redirect" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:fontFamily="monospace" android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:textIsSelectable="true" />
            </LinearLayout>

            <TextView style="@style/TextAppearance.MailGram.Caption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" android:text="@string/settings_about" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">

                <TextView android:id="@+id/settings_versions" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" android:textIsSelectable="true" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="18dp" android:text="@string/settings_logout"
                android:textAllCaps="false" android:textColor="@color/google_red"
                app:cornerRadius="26dp" app:strokeColor="@color/google_red" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
