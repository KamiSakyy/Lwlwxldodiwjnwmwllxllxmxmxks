<?xml version="1.0" encoding="utf-8"?>
<!--
  Настройки в стиле iOS 26: карточки со скруглением 16dp на чёрном фоне,
  строки с шевронами, переключатели Material 3 и акцентный голубой цвет.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        style="@style/Widget.MailGram.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_bar"
        android:minHeight="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings"
        app:titleTextAppearance="@style/TextAppearance.MailGram.ChatTitle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="28dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/settings_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- профиль -->
            <LinearLayout
                style="@style/Widget.MailGram.Card"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.mailgram.app.ui.AvatarView
                    android:id="@+id/settings_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/settings_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.MailGram.RowTitle"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settings_identity_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.MailGram.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- оформление -->
            <TextView
                style="@style/Widget.MailGram.SectionTitle"
                android:text="@string/settings_appearance" />

            <LinearLayout style="@style/Widget.MailGram.Card">

                <LinearLayout
                    style="@style/Widget.MailGram.CardRow"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:text="@string/settings_theme"
                        android:textAppearance="@style/TextAppearance.MailGram.BodySmall"
                        android:textColor="@color/text_secondary" />

                    <RadioGroup
                        android:id="@+id/theme_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/theme_dark"
                            style="@style/Widget.MailGram.RadioButton"
                            android:layout_width="match_parent"
                            android:text="@string/theme_dark" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/theme_system"
                            style="@style/Widget.MailGram.RadioButton"
                            android:layout_width="match_parent"
                            android:text="@string/theme_system" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/theme_light"
                            style="@style/Widget.MailGram.RadioButton"
                            android:layout_width="match_parent"
                            android:text="@string/theme_light" />
                    </RadioGroup>
                </LinearLayout>

                <View style="@style/Widget.MailGram.Separator" android:layout_marginStart="16dp" />

                <LinearLayout
                    android:id="@+id/row_wallpaper"
                    style="@style/Widget.MailGram.CardRow">

                    <TextView
                        style="@style/Widget.MailGram.RowTitle"
                        android:text="@string/settings_wallpaper" />

                    <TextView
                        android:id="@+id/settings_wallpaper_value"
                        style="@style/Widget.MailGram.RowValue" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/settings_wallpaper"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>

                <View style="@style/Widget.MailGram.Separator" android:layout_marginStart="16dp" />

                <LinearLayout
                    android:id="@+id/row_font_scale"
                    style="@style/Widget.MailGram.CardRow">

                    <TextView
                        style="@style/Widget.MailGram.RowTitle"
                        android:text="@string/settings_font" />

                    <TextView
                        android:id="@+id/settings_font_value"
                        style="@style/Widget.MailGram.RowValue" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/settings_font"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>

                <View style="@style/Widget.MailGram.Separator" android:layout_marginStart="16dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_animations"
                    style="@style/Widget.MailGram.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_animations"
                    android:textAppearance="@style/TextAppearance.MailGram.RowTitle"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- сообщения и синхронизация -->
            <TextView
                style="@style/Widget.MailGram.SectionTitle"
                android:text="@string/settings_sync" />

            <LinearLayout style="@style/Widget.MailGram.Card">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_background"
                    style="@style/Widget.MailGram.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_background"
                    android:textAppearance="@style/TextAppearance.MailGram.RowTitle"
                    android:textColor="@color/text_primary" />

                <View style="@style/Widget.MailGram.Separator" android:layout_marginStart="16dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_plain"
                    style="@style/Widget.MailGram.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_plain_mode"
                    android:textAppearance="@style/TextAppearance.MailGram.RowTitle"
                    android:textColor="@color/text_primary" />

                <View style="@style/Widget.MailGram.Separator" android:layout_marginStart="16dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_notifications"
                    style="@style/Widget.MailGram.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_notifications"
                    android:textAppearance="@style/TextAppearance.MailGram.RowTitle"
                    android:textColor="@color/text_primary" />

                <View style="@style/Widget.MailGram.Separator" android:layout_marginStart="16dp" />

                <LinearLayout
                    android:id="@+id/row_poll"
                    style="@style/Widget.MailGram.CardRow">

                    <TextView
                        style="@style/Widget.MailGram.RowTitle"
                        android:text="@string/settings_poll" />

                    <TextView
                        android:id="@+id/settings_poll_value"
                        style="@style/Widget.MailGram.RowValue" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/settings_poll"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>
            </LinearLayout>

            <!-- безопасность -->
            <TextView
                style="@style/Widget.MailGram.SectionTitle"
                android:text="@string/settings_security" />

            <LinearLayout style="@style/Widget.MailGram.Card">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_app_lock"
                    style="@style/Widget.MailGram.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/app_lock"
                    android:textAppearance="@style/TextAppearance.MailGram.RowTitle"
                    android:textColor="@color/text_primary" />

                <View style="@style/Widget.MailGram.Separator" android:layout_marginStart="16dp" />

                <LinearLayout
                    android:id="@+id/row_mykey"
                    style="@style/Widget.MailGram.CardRow">

                    <TextView
                        style="@style/Widget.MailGram.RowTitle"
                        android:text="@string/my_key" />

                    <TextView
                        style="@style/Widget.MailGram.RowValue"
                        android:text="@string/settings_identity" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/my_key"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>

                <View style="@style/Widget.MailGram.Separator" android:layout_marginStart="16dp" />

                <LinearLayout
                    android:id="@+id/row_ratchet"
                    style="@style/Widget.MailGram.CardRow"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        style="@style/Widget.MailGram.RowTitle"
                        android:text="@string/settings_ratchet" />

                    <TextView
                        android:id="@+id/settings_ratchet_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textAppearance="@style/TextAppearance.MailGram.Caption" />
                </LinearLayout>

                <View style="@style/Widget.MailGram.Separator" android:layout_marginStart="16dp" />

                <LinearLayout
                    android:id="@+id/row_selftest"
                    style="@style/Widget.MailGram.CardRow"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        style="@style/Widget.MailGram.RowTitle"
                        android:text="@string/settings_selftest" />

                    <TextView
                        android:id="@+id/settings_selftest_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textAppearance="@style/TextAppearance.MailGram.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- о приложении -->
            <TextView
                style="@style/Widget.MailGram.SectionTitle"
                android:text="@string/settings_about" />

            <LinearLayout style="@style/Widget.MailGram.Card">

                <LinearLayout
                    android:id="@+id/row_invite_link"
                    style="@style/Widget.MailGram.CardRow"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        style="@style/Widget.MailGram.RowTitle"
                        android:text="@string/invite_send" />

                    <TextView
                        android:id="@+id/settings_invite_link"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textAppearance="@style/TextAppearance.MailGram.Caption" />
                </LinearLayout>

                <View style="@style/Widget.MailGram.Separator" android:layout_marginStart="16dp" />

                <LinearLayout
                    android:id="@+id/row_setup"
                    style="@style/Widget.MailGram.CardRow">

                    <TextView
                        style="@style/Widget.MailGram.RowTitle"
                        android:text="@string/setup_title" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/setup_title"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>

                <View style="@style/Widget.MailGram.Separator" android:layout_marginStart="16dp" />

                <TextView
                    android:id="@+id/settings_client_id"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:textAppearance="@style/TextAppearance.MailGram.Caption" />

                <TextView
                    android:id="@+id/settings_redirect"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:textAppearance="@style/TextAppearance.MailGram.Caption" />

                <TextView
                    android:id="@+id/settings_versions"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:textAppearance="@style/TextAppearance.MailGram.Caption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                style="@style/Widget.MailGram.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:text="@string/settings_logout"
                android:textColor="@color/danger"
                app:strokeColor="@color/danger" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/tagline"
                android:textAppearance="@style/TextAppearance.MailGram.Caption"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
