<?xml version="1.0" encoding="utf-8"?>
<!--
  Строка списка чатов — точно как .dialog в старом мессенджере:
  padding 12/14, аватар 50dp + отступ 12dp, имя 15sp/600, превью 13sp #888,
  время 11sp #666, синий счётчик 20dp (#0a84ff, 11sp/700), точка «в сети»
  14dp с обводкой 2.5dp, разделитель 1dp #111.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_row_ripple"
        android:gravity="center_vertical"
        android:minHeight="74dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="50dp"
        android:layout_height="50dp">

        <com.mailgram.app.ui.AvatarView
            android:id="@+id/chat_avatar"
            android:layout_width="50dp"
            android:layout_height="50dp" />

        <View
            android:id="@+id/chat_online_dot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_online_dot" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chat_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chat_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/chat_state_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@string/encryption_on"
                android:src="@drawable/ic_lock"
                android:visibility="gone"
                app:tint="@color/success" />

            <ImageView
                android:id="@+id/chat_mute_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@string/mute_chat"
                android:src="@drawable/ic_mute"
                android:visibility="gone"
                app:tint="@color/text_icon" />

            <ImageView
                android:id="@+id/chat_pin_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@string/pin_chat"
                android:src="@drawable/ic_pin"
                android:visibility="gone"
                app:tint="@color/text_icon" />

            <TextView
                android:id="@+id/chat_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chat_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_nav_badge"
                android:gravity="center"
                android:minWidth="20dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/text_on_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/row_divider" />
</LinearLayout>
