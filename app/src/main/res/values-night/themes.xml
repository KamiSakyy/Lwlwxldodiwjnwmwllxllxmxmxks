<?xml version="1.0" encoding="utf-8"?>
<!--
  Тема MailGram (чёрная, чистый чёрный фон как в iOS Dark и Telegram Night). Собирается скриптом tools/make_themes.py:
  наборы стилей в светлой и чёрной темах совпадают полностью.
-->
<resources>
    <style name="Theme.MailGram" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/brand</item>
        <item name="colorControlHighlight">@color/ripple</item>
        <item name="colorControlNormal">@color/text_primary</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">#FFFFFFFF</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorOnPrimaryContainer">@color/text_on_accent</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryContainer">@color/brand</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorSecondaryContainer">@color/brand_soft</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_alt</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorTertiary">@color/brand</item>
        <item name="rippleColor">@color/ripple</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.MailGram</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/Theme.MailGram.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/Theme.MailGram.Sheet</item>
        <item name="toolbarStyle">@style/Widget.MailGram.Toolbar</item>
        <item name="android:toolbarStyle">@style/Widget.MailGram.Toolbar</item>
    </style>

    <style name="Animation.MailGram" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_slight</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_slight</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="ShapeAppearance.MailGram.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="ShapeAppearance.MailGram.Media" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.MailGram.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.MailGram.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="TextAppearance.MailGram.Hero" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.MailGram.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.MailGram.RowTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.MailGram.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.MailGram.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.MailGram.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.MailGram.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TextAppearance.MailGram.ChatTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.MailGram.ChatSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/brand</item>
    </style>

    <style name="TextAppearance.MailGram.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.MailGram.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:minHeight">56dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.MailGram.ChatTitle</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.MailGram.Caption</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="contentInsetStartWithNavigation">4dp</item>
        <item name="contentInsetStart">4dp</item>
        <item name="contentInsetEnd">4dp</item>
    </style>

    <style name="Widget.MailGram.GlassIcon" parent="">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/bg_header_icon</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/text_primary</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.MailGram.Pill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textAppearance">@style/TextAppearance.MailGram.BodySmall</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:background">@drawable/bg_glass_pill</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.MailGram.PillActive" parent="Widget.MailGram.Pill">
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_pill_accent</item>
    </style>

    <style name="Widget.MailGram.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/bg_row_ripple</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.MailGram.RowTitle" parent="TextAppearance.MailGram.RowTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="Widget.MailGram.RowValue" parent="TextAppearance.MailGram.BodySmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingStart">10dp</item>
    </style>

    <style name="Widget.MailGram.SectionTitle" parent="TextAppearance.MailGram.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingBottom">9dp</item>
    </style>

    <style name="Widget.MailGram.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="Widget.MailGram.CardRow" parent="Widget.MailGram.Row">
    </style>

    <style name="Widget.MailGram.Separator" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@drawable/bg_separator</item>
    </style>

    <style name="Widget.MailGram.Button.Accent" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.MailGram.Button</item>
        <item name="app:cornerRadius">16dp</item>
        <item name="app:rippleColor">@color/ripple_strong</item>
        <item name="app:iconTint">@color/text_on_accent</item>
        <item name="app:iconPadding">10dp</item>
        <item name="app:iconGravity">textStart</item>
    </style>

    <style name="Widget.MailGram.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.MailGram.Button</item>
        <item name="app:strokeColor">@color/divider</item>
        <item name="app:strokeWidth">1dp</item>
        <item name="app:cornerRadius">16dp</item>
        <item name="app:rippleColor">@color/ripple</item>
    </style>

    <style name="Widget.MailGram.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.MailGram.Button</item>
        <item name="app:rippleColor">@color/ripple</item>
    </style>

    <style name="Widget.MailGram.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minHeight">48dp</item>
        <item name="app:thumbTint">@color/text_on_accent</item>
    </style>

    <style name="Widget.MailGram.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:textAppearance">@style/TextAppearance.MailGram.RowTitle</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:buttonTint">@color/brand</item>
        <item name="app:buttonTint">@color/brand</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.MailGram.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="android:layout_height">3dp</item>
        <item name="app:indicatorColor">@color/brand</item>
        <item name="app:trackColor">@color/divider</item>
        <item name="app:trackThickness">3dp</item>
    </style>

    <style name="Widget.MailGram.Input" parent="Widget.Material3.TextInputEditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.MailGram.FileRow" parent="Widget.MailGram.Card">
        <item name="android:background">@drawable/bg_row_ripple_round</item>
    </style>

    <style name="Widget.MailGram.AttachAction" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">84dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/bg_row_ripple_round</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.MailGram.AttachIcon" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_attach_sheet_icon</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">@color/brand</item>
    </style>

    <style name="Widget.MailGram.AttachLabel" parent="TextAppearance.MailGram.Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Theme.MailGram.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:colorBackgroundFloating">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_alt</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.MailGram.Dialog</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.MailGram.Dialog</item>
    </style>

    <style name="Theme.MailGram.Sheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MailGram.BottomSheet</item>
        <item name="android:colorBackgroundFloating">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_alt</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.MailGram.Dialog</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.MailGram.Dialog</item>
    </style>

    <style name="Widget.MailGram.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_sheet</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

    <style name="Theme.MailGram.Transparent" parent="Theme.MailGram">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.MailGram.Fullscreen" parent="Theme.MailGram">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
