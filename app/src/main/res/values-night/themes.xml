<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MailGram" parent="Theme.MailGram.Base" />

    <style name="Theme.MailGram.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_dark</item>
        <item name="colorOnPrimary">#FF000000</item>
        <item name="colorPrimaryContainer">@color/accent</item>
        <item name="colorOnPrimaryContainer">#FFFFFFFF</item>
        <item name="colorSecondary">@color/accent_dark</item>
        <item name="colorOnSecondary">#FF000000</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_grouped_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorOutline">@color/divider_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="colorBubbleOut">@color/bubble_out_dark</item>
        <item name="colorBubbleIn">@color/bubble_in_dark</item>
        <item name="colorChatBackground">@color/bg_dark</item>
        <item name="materialAlertDialogTheme">@style/Theme.MailGram.Dialog</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:windowAnimationStyle">@style/Animation.MailGram</item>
        <item name="colorGlass">@color/glass_dark</item>
        <item name="colorGlassStrong">@color/glass_dark_strong</item>
        <item name="colorGlassBorder">@color/glass_border_dark</item>
        <item name="colorWallpaperCore">@color/wallpaper_core_dark</item>
        <item name="colorWallpaperIndigo">@color/wallpaper_indigo_dark</item>
        <item name="colorWallpaperGlow">@color/wallpaper_glow_dark</item>
        <item name="colorWallpaperGlow2">@color/wallpaper_glow2_dark</item>
        <item name="colorBubbleOutTop">@color/bubble_out_top_dark</item>
        <item name="colorBubbleOutBottom">@color/bubble_out_bottom_dark</item>
        <item name="colorBubbleInTop">@color/bubble_in_top_dark</item>
        <item name="colorBubbleInBottom">@color/bubble_in_bottom_dark</item>
        <item name="colorReactionBg">@color/reaction_bg_dark</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowSharedElementEnterTransition">@transition/shared_enter</item>
        <item name="android:windowSharedElementExitTransition">@transition/shared_exit</item>
    </style>

    <style name="TextAppearance.MailGram.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MailGram.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
