<?xml version="1.0" encoding="utf-8"?>
<!-- Свечение вокруг знака на входе: радиальный градиент бренда + стеклянное кольцо. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="64dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#400A84FF"
                android:endColor="#000A84FF" />
        </shape>
    </item>
    <item
        android:left="26dp"
        android:top="26dp"
        android:right="26dp"
        android:bottom="26dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
