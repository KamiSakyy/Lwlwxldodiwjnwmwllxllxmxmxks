<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorWallpaperCore" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.2"
                android:centerY="0.05"
                android:gradientRadius="70%p"
                android:startColor="?attr/colorWallpaperGlow"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.85"
                android:centerY="0.95"
                android:gradientRadius="60%p"
                android:startColor="?attr/colorWallpaperGlow2"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
