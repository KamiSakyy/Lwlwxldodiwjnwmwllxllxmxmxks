    <style name="Widget.MailGram.InfoBox" parent="TextAppearance.MailGram.ModalText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_info_box</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.MailGram.WarnBox" parent="TextAppearance.MailGram.ModalText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_warn_box</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.MailGram.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:backgroundTint">#FFFFFFFF</item>
        <item name="android:textColor">@color/text_on_light</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/ripple_strong</item>
    </style>

    <style name="Widget.MailGram.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
