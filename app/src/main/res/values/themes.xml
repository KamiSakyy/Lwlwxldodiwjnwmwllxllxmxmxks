        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/ripple</item>
    </style>

    <style name="Widget.MailGram.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:layout_height">50dp</item>
        <item name="android:backgroundTint">@color/danger</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/ripple_strong</item>
    </style>

    <style name="Widget.MailGram.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="rippleColor">@color/ripple</item>
    </style>

    <style name="Widget.MailGram.Button.Accent" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/ripple_strong</item>
    </style>

