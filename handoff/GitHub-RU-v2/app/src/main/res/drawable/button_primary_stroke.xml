<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="@color/rippleColor"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/borderPrimary" />
                    <corners android:radius="@dimen/corner_radius_medium" />
                </shape>
            </item>
            <item android:left="1.0dip" android:top="1.0dip" android:right="1.0dip" android:bottom="1.0dip">
                <shape android:shape="rectangle">
                    <solid android:color="@color/backgroundTertiary" />
                    <corners android:radius="@dimen/corner_radius_medium" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
