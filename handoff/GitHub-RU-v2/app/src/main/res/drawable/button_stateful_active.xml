<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="@color/rippleColor"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item android:left="0.5dip" android:top="0.5dip" android:right="0.5dip" android:bottom="0.5dip">
                <shape android:shape="rectangle">
                    <solid android:color="@color/buttonActiveBackground" />
                    <corners android:radius="@dimen/corner_radius_medium" />
                </shape>
            </item>
            <item android:height="12.0dip" android:left="0.5dip" android:top="0.5dip" android:right="0.5dip" android:bottom="0.5dip">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#09000000" android:endColor="#00000000" android:angle="-90.0" android:centerY="0.25" android:centerColor="#00000000" />
                    <corners android:radius="6.0dip" />
                </shape>
            </item>
            <item android:width="12.0dip" android:left="0.5dip" android:top="0.5dip" android:right="0.5dip" android:bottom="0.5dip">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#09000000" android:endColor="#00000000" android:angle="0.0" android:centerY="0.2" android:centerColor="#00000000" />
                    <corners android:radius="6.0dip" />
                </shape>
            </item>
            <item android:gravity="end" android:width="12.0dip" android:left="0.5dip" android:top="0.5dip" android:right="0.5dip" android:bottom="0.5dip">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#09000000" android:endColor="#00000000" android:angle="180.0" android:centerY="0.2" android:centerColor="#00000000" />
                    <corners android:radius="6.0dip" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="0.5dip" android:color="@color/border" />
                    <corners android:radius="6.0dip" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
